# ---------------------------------------------------------------------------
# Variables de entorno de la API de OpticaHefesto
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es un secreto real.
#
# Para trabajar: `cp .env.example .env` y cambiar lo marcado como RELLENAR.
#
# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------

APP_NAME="OpticaHefesto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Santiago

# La sesion expira en minutos. En una optica una sesion abierta mucho rato es
# una sesion abierta a las graduaciones de los pacientes.
SESSION_EXPIRACION_MINUTOS=120

# En produccion tiene que ser `true`. Sin HTTPS la cookie viaja en claro.
SESSION_SECURE_COOKIE=false

# En produccion: `stderr`. Nunca un archivo dentro del contenedor.
LOG_CHANNEL=stack
LOG_STACK=stderr
# `debug` deja el cuerpo de las peticiones en el registro, y las peticiones
# llevan graduaciones. Ver docs/07.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=optica
# Rol de la APLICACION. Lo crea `deploy/postgres/inicializar-rol.sh` con
# NOSUPERUSER y NOBYPASSRLS explicitos. NO puede ser superusuario: con
# superusuario PostgreSQL ignora las politicas de Row Level Security y una
# optica veria las recetas de otra. Ver docs/03.
DB_USERNAME=optica
DB_PASSWORD=

# Rol de ARRANQUE de PostgreSQL. La imagen oficial lo crea superusuario, asi que
# la aplicacion NUNCA conecta con el: solo se usa para crear la base y para lo
# administrativo. Es un secreto DISTINTO del de `DB_PASSWORD`.
DB_ADMIN_USERNAME=optica_admin
DB_ADMIN_PASSWORD=

# Conexion aparte para la bitacora de accesos a recetas. Por defecto es la
# misma base: una peticion denegada se revierte, pero el registro del intento
# tiene que sobrevivir.
DB_AUDITORIA_HOST=pgsql
DB_AUDITORIA_PORT=5432
DB_AUDITORIA_DATABASE=optica
# Tiene que ser IGUAL a `DB_USERNAME`: mientras lo sea, es el mismo rol y el
# script de arranque no crea nada extra. Si se cambia por otro rol, hay que
# poner TAMBIEN `DB_AUDITORIA_PASSWORD`, porque `deploy/postgres/inicializar-rol.sh`
# falla en voz alta antes de crear un rol sin contrasena.
DB_AUDITORIA_USERNAME=optica
DB_AUDITORIA_PASSWORD=
DB_AUDITORIA_SSLMODE=prefer

DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Caché y colas
# ---------------------------------------------------------------------------

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Authentik (OpenID Connect)
# ---------------------------------------------------------------------------
#
# Mismos valores que el kit `kits/hefesto-identidad-authentik`, con un cliente
# OIDC PROPIO de esta aplicacion. Ver docs/05.
# ---------------------------------------------------------------------------

AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/acceso/callback

AUTHENTIK_SCOPES="openid profile email"
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_LEEWAY=60
AUTHENTIK_CACHE_METADATA=3600
AUTHENTIK_CACHE_JWKS=86400

# Prefijo de los equipos de Authentik que declaran la optica. El equipo se
# llama `<prefijo>:<correlacion>`, por ejemplo `OpticaHefesto:centro`.
AUTHENTIK_GRUPO_POR_OPTICA=OpticaHefesto

# ---------------------------------------------------------------------------
# Interfaz (Nuxt)
# ---------------------------------------------------------------------------
#
# Solo para CORS en desarrollo. En produccion el navegador nunca habla
# directo con la API: va por el mismo origen a traves del proxy.
# ---------------------------------------------------------------------------

OPTICA_URL_WEB=http://localhost:3000

# ---------------------------------------------------------------------------
# VIGENCIA DE LA RECETA
# ---------------------------------------------------------------------------
#
# TODAS ESTAS VARIABLES NACEN VACIAS, Y ESO ES LO CORRECTO.
#
# El plazo de vigencia de una receta optica por franja etaria es norma
# sanitaria chilena. En la maquina donde se escribio esta aplicacion NO se pudo
# verificar contra la norma vigente, asi que no se escribe ningun numero.
#
# Mientras esten vacias:
#   - el sistema no vence recetas por su cuenta;
#   - cada receta nace con `fecha_vencimiento` nula;
#   - la interfaz avisa que el plazo esta pendiente de verificacion.
#
# Ver docs/06 y docs/07.
# ---------------------------------------------------------------------------

# Dias de vigencia para pacientes de hasta 12 anios.
OPTICA_VIGENCIA_HASTA_12_ANIOS=
# Dias de vigencia para pacientes de 13 a 17 anios.
OPTICA_VIGENCIA_13_A_17_ANIOS=
# Dias de vigencia para pacientes de 18 a 59 anios.
OPTICA_VIGENCIA_18_A_59_ANIOS=
# Dias de vigencia para pacientes de 60 anios y mas.
OPTICA_VIGENCIA_DESDE_60_ANIOS=

# Dias de aviso antes del vencimiento. No es una obligacion: es cuando el
# sistema avisa.
OPTICA_DIAS_DE_AVISO=30

# ---------------------------------------------------------------------------
# COMPATIBILIDAD ARMazon / LENTE
# ---------------------------------------------------------------------------
#
# Margen minimo que el lente necesita para cubrir el centro optico y alcanzar
# el borde del armazon, en milimetros, por lado.
#
# Nace VACIO a proposito: no se pudo verificar que valor corresponde contra la
# norma vigente ni contra las fichas tecnicas de los fabricantes. Mientras
# este vacio, el servicio de compatibilidad devuelve `no_verificable` con el
# desglose de lo que si pudo calcular, y NO devuelve si o no. Ver docs/06.
# ---------------------------------------------------------------------------

OPTICA_DIAMETRO_EFECTIVO_MINIMO_MM=

# ---------------------------------------------------------------------------
# PEDIDO A LABORATORIO
# ---------------------------------------------------------------------------
#
# Dias prometidos por omision al crear un pedido. Es un valor COMERCIAL: lo
# negocia la optica con su laboratorio y cambia segun la temporada. Nace
# vacio. Ver docs/06.
# ---------------------------------------------------------------------------

OPTICA_DIAS_LABORATORIO=

# ---------------------------------------------------------------------------
# CONTROL DE CALIDAD AL RECIBIR
# ---------------------------------------------------------------------------
#
# Tolerancia con que se acepta la graduacion que llega del laboratorio. Es una
# decision clinica del optometrista, no una constante del software.
#
# Mientras este vacio, el control de calidad sigue comparando valor por valor
# y muestra las diferencias, pero NO emite un veredicto automatico. El
# veredicto lo pone la persona. Ver docs/06.
# ---------------------------------------------------------------------------

OPTICA_TOLERANCIA_DIOPTRIAS=
OPTICA_TOLERANCIA_EJE_GRADOS=

# ---------------------------------------------------------------------------
# CONSERVACION
# ---------------------------------------------------------------------------
#
# Cuanto tiempo se conservan recetas y bitacora de accesos. Depende del
# contrato de tratamiento de datos y de la normativa sectorial. NO se pudo
# verificar el plazo que corresponde, asi que nace vacio.
#
# Con estas variables vacias la aplicacion NO purga nada por su cuenta.
# Ver docs/07.
# ---------------------------------------------------------------------------

OPTICA_RETENCION_RECETAS_DIAS=
OPTICA_RETENCION_ACCESOS_RECETAS_DIAS=

# ---------------------------------------------------------------------------
# Alertas de la bitacora
# ---------------------------------------------------------------------------

OPTICA_ALERTA_DENEGADOS_POR_HORA=20
OPTICA_ALERTA_DENEGADOS_POR_USUARIO=5

# ---------------------------------------------------------------------------
# Entregas y ajustes
# ---------------------------------------------------------------------------
#
# Sugerencia de dias para ordenar la cola de ajustes posteriores a la entrega.
# NO es un plazo legal de garantia: nace vacio.
# ---------------------------------------------------------------------------

OPTICA_DIAS_DE_GARANTIA_SUGERIDOS=