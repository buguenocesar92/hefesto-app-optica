# =============================================================================
# Entorno de PRODUCCION de OpticaHefesto.
# =============================================================================
#
# Copielo a `.env.prod` y complete TODOS los valores marcados.
#
#     cp .env.prod.example .env.prod
#     docker compose --env-file .env.prod up -d
#
# `.env.prod` NO SE VERSIONA. Tendra las contrasenas y el secreto del cliente
# OIDC.
#
# `docker compose config` imprime los valores ya resueltos: no hay que pegarlo
# en ningun ticket ni en ningun chat.
#
# LO QUE ESTA VACIO Y POR QUE
# ---------------------------
# Las variables `OPTICA_*` de plazos, tolerancias y margenes estan vacias a
# proposito: son valores que NO se pudieron verificar al escribir la aplicacion.
# Ver `docs/05-CONFIGURACION.md`. La aplicacion arranca igual y avisa que estan
# pendientes.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------

APP_NAME=OpticaHefesto

# OBLIGATORIA. Se genera con:
#   docker compose --env-file .env.prod run --rm api php artisan key:generate --show
APP_KEY=

OPTICA_URL_WEB=https://optica.ejemplo.cl

# Con varias replicas, las migraciones se corren una vez a mano y se apaga el
# `migrate` del arranque. Ver docs/04.
MIGRAR_AL_ARRANCAR=true

# `debug` deja el cuerpo de las peticiones en el registro, y las peticiones
# llevan graduaciones. Ver docs/07.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Proxy
# -----------------------------------------------------------------------------

# Con el dominio vacio el proxy queda en HTTP. Para HTTPS hay que ponerlo y
# apuntar el DNS.
DOMINIO=
CORREO_PROXY=admin@ejemplo.cl

PUERTO_HTTP=80
PUERTO_HTTPS=443

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------

DB_DATABASE=optica
DB_USERNAME=optica

# OBLIGATORIA. La que usa la conexion principal y la de auditoria.
DB_PASSWORD=

DB_SSLMODE=prefer

# Opcionales: si la base de auditoria esta en otro lado, se separan aqui.
DB_AUDITORIA_DATABASE=
DB_AUDITORIA_USERNAME=
DB_AUDITORIA_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# OBLIGATORIA.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Authentik (OpenID Connect)
# -----------------------------------------------------------------------------

# OBLIGATORIAS. Cliente PROPIO de esta aplicacion, no el de otra del estudio.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://optica.ejemplo.cl/api/v1/acceso/callback

# El equipo que declara la optica. El nombre completo del equipo en Authentik
# es `<prefijo>:<correlacion>`, por ejemplo `OpticaHefesto:centro`.
AUTHENTIK_GRUPO_POR_OPTICA=OpticaHefesto

# -----------------------------------------------------------------------------
# VIGENCIA DE LA RECETA
# -----------------------------------------------------------------------------
#
# NORMATIVA SANITARIA CHILENA. NO VERIFICADA AL ESCRIBIR LA APLICACION.
#
# Mientras esten vacias: el sistema no vence recetas por su cuenta, cada receta
# nace sin fecha de vencimiento y la interfaz avisa que el plazo esta pendiente.
# Ver docs/06-PRIMERA-RECETA.md y docs/07-SEGURIDAD-Y-LEY-19628.md.
# -----------------------------------------------------------------------------

OPTICA_VIGENCIA_HASTA_12_ANIOS=
OPTICA_VIGENCIA_13_A_17_ANIOS=
OPTICA_VIGENCIA_18_A_59_ANIOS=
OPTICA_VIGENCIA_DESDE_60_ANIOS=

# Dias de aviso antes del vencimiento. No es una obligacion: es cuando el
# sistema avisa.
OPTICA_DIAS_DE_AVISO=30

# -----------------------------------------------------------------------------
# COMPATIBILIDAD ARMazon / LENTE
# -----------------------------------------------------------------------------
#
# NO VERIFICADO. Mientras este vacio, el servicio de compatibilidad responde
# `no_verificable` con el desglose geometrico, y NUNCA "compatible".
# Ver docs/06-PRIMERA-RECETA.md.
# -----------------------------------------------------------------------------

OPTICA_DIAMETRO_EFECTIVO_MINIMO_MM=

# -----------------------------------------------------------------------------
# PEDIDO A LABORATORIO
# -----------------------------------------------------------------------------
#
# COMERCIAL: lo negocia la optica con su laboratorio. NO VERIFICADO.
# -----------------------------------------------------------------------------

OPTICA_DIAS_LABORATORIO=

# -----------------------------------------------------------------------------
# CONTROL DE CALIDAD
# -----------------------------------------------------------------------------
#
# DECISION CLINICA del optometrista. NO VERIFICADO.
#
# Mientras este vacio, el control sigue comparando valor por valor y muestra las
# diferencias, pero NO emite un veredicto automatico.
# -----------------------------------------------------------------------------

OPTICA_TOLERANCIA_DIOPTRIAS=
OPTICA_TOLERANCIA_EJE_GRADOS=

# -----------------------------------------------------------------------------
# CONSERVACION
# -----------------------------------------------------------------------------
#
# NO VERIFICADO. Con estas variables vacias la aplicacion NO purga nada por su
# cuenta. Ver docs/07-SEGURIDAD-Y-LEY-19628.md.
# -----------------------------------------------------------------------------

OPTICA_RETENCION_RECETAS_DIAS=
OPTICA_RETENCION_ACCESOS_RECETAS_DIAS=

# -----------------------------------------------------------------------------
# Entregas y ajustes
# -----------------------------------------------------------------------------
#
# Decision COMERCIAL, no un plazo legal de garantia. NO VERIFICADO.
# -----------------------------------------------------------------------------

OPTICA_DIAS_DE_GARANTIA_SUGERIDOS=

# -----------------------------------------------------------------------------
# Alertas de la bitacora
# -----------------------------------------------------------------------------

OPTICA_ALERTA_DENEGADOS_POR_HORA=20
OPTICA_ALERTA_DENEGADOS_POR_USUARIO=5